# ══════════════════════════════════════════════════════════════════════════════
# Wodi — Environment Configuration
#
# Copy this file to .env and fill in the values you need.
# Only one LLM provider is required — the system auto-selects by priority:
#   1. Gemini (if GEMINI_API_KEY is set)
#   2. Groq   (if GROQ_API_KEY is set)
#   3. Ollama (local, always available if running)
# ══════════════════════════════════════════════════════════════════════════════

# ── Google Gemini ─────────────────────────────────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# ── Groq Cloud ────────────────────────────────────────────────────────────────
# GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.1-8b-instant

# ── Ollama (local, default) ───────────────────────────────────────────────────
# WODI_OLLAMA_HOST=http://localhost:11434
# WODI_PLANNER_MODEL=qwen2.5:7b

# ── Tavily Web Search (optional, higher-quality web search) ───────────────────
# TAVILY_API_KEY=your-tavily-api-key-here

# ── FastAPI Backend ───────────────────────────────────────────────────────────
# BACKEND_PORT=8765
# MAX_CONTEXT_MESSAGES=8

# ── Logging ───────────────────────────────────────────────────────────────────
# WODI_LOG_LEVEL=INFO
