# ══════════════════════════════════════════════════════════════════════════════
# Wodi — Environment Configuration
#
# Copy this file to .env and set your GROQ_API_KEY.
# ══════════════════════════════════════════════════════════════════════════════

# ── Groq Cloud (Primary Engine) ───────────────────────────────────────────────
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# Supported Models:
#   - llama-3.3-70b-versatile (Recommended: 70B reasoning & tool use)
#   - llama-3.1-8b-instant   (Ultra-fast 8B model)
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (Alternative Cloud Provider) ────────────────────────────────
# GEMINI_API_KEY=your-gemini-api-key-here
# GEMINI_MODEL=gemini-1.5-flash

# ── Tavily Web Search (Optional) ──────────────────────────────────────────────
# TAVILY_API_KEY=your-tavily-api-key-here

# ── Inworld AI Text-to-Speech (Recommended Voice Engine) ──────────────────────
# Get your API key from: https://platform.inworld.ai/
INWORLD_API_KEY=your-inworld-api-key-here
INWORLD_VOICE=Avery
INWORLD_MODEL=inworld-tts-2
INWORLD_DELIVERY_MODE=CREATIVE
INWORLD_LANGUAGE=AUTO

# ── FastAPI Backend ───────────────────────────────────────────────────────────
BACKEND_PORT=8765
MAX_CONTEXT_MESSAGES=8

# ── Logging ───────────────────────────────────────────────────────────────────
WODI_LOG_LEVEL=INFO

