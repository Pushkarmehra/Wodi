# Nex AI Desktop Agent Configuration

# ── LLM Provider ──
# Set ONE of these. If both are set, GROQ takes precedence.

# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (https://console.groq.com/)
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
TAVILY_API_KEY= 

# ── Desktop Shell ──
# Global shortcut to toggle the popup (default: CommandOrControl+Alt+Space)
# GLOBAL_SHORTCUT=CommandOrControl+Alt+Space

# ── Server ──
# BACKEND_PORT=8000
